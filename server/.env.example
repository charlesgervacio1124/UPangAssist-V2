MONGODB_URI=mongodb://127.0.0.1:27017/upang-assist
PORT=3000
AUTH_TOKEN_SECRET=replace-with-a-random-secret-at-least-32-bytes
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=UPang Support Administrator
CLIENT_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174
# Google OAuth Web client ID used to verify Google Identity Services ID tokens.
GOOGLE_CLIENT_ID=

# Optional local AI settings
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
LLM_PROVIDER=ollama
